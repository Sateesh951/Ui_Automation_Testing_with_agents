<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{ISO8601} %-5p [%t] %c{1} - %m%n"/>
        </Console>
        <File name="ExecutionFile" fileName="${sys:framework.log.file:-reports/execution.log}" append="true">
            <PatternLayout pattern="%d{ISO8601} %-5p [%t] %c{1} - %m%n"/>
        </File>
    </Appenders>
    <Loggers>
        <Root level="INFO"><AppenderRef ref="Console"/><AppenderRef ref="ExecutionFile"/></Root>
    </Loggers>
</Configuration>
