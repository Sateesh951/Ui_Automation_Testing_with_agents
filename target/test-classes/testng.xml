<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cucumber BDD and API Automation">
    <listeners>
        <listener class-name="com.automation.listeners.FrameworkListener"/>
    </listeners>
    <test name="Cucumber feature scenarios">
        <classes><class name="com.automation.tests.cucumber.CucumberTestRunner"/></classes>
    </test>
    <test name="API tests">
        <groups><run><include name="api"/></run></groups>
        <classes><class name="com.automation.tests.api.DataDrivenApiTest"/></classes>
    </test>
</suite>
